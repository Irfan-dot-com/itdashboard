[Unit]
Description=Syslog Edge Agent (IT Dashboard)
Documentation=file:/opt/edge-agent/app/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edge-agent
Group=edge-agent
WorkingDirectory=/opt/edge-agent/app
ExecStart=/opt/edge-agent/venv/bin/python -u /opt/edge-agent/app/main.py

# Restart forever - an edge box is unattended
Restart=always
RestartSec=5s
# Don't give up after repeated crashes
StartLimitIntervalSec=0

# Bind UDP 514 without running as root.
# Required because 514 is a privileged port; drop it if you listen on 5514
# and redirect 514 -> 5514 with iptables instead.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Writable state
StateDirectory=edge-agent
LogsDirectory=edge-agent
ReadWritePaths=/var/lib/edge-agent /var/log/edge-agent

# Hardening - the agent only needs to read one config, write a queue and a log,
# and make outbound HTTPS.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource ceilings - a syslog flood must not take the box down
MemoryMax=512M
TasksMax=64

StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-agent

[Install]
WantedBy=multi-user.target
