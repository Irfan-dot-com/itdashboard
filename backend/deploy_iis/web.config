<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  IIS site config for the IT Dashboard API — HttpPlatformHandler approach.

  IIS launches and supervises uvicorn itself; there is no separate Windows
  service to install. Put this file at the root of the API site, e.g.
      C:\inetpub\itdashboard-api\web.config

  PREREQUISITE: the HttpPlatformHandler module must be installed.
      https://www.iis.net/downloads/microsoft/httpplatformhandler
  Verify with:  Get-WebGlobalModule | Where-Object Name -like "*httpPlatform*"

  EDIT the three marked paths below.

  ===========================================================================
  THE TWO SETTINGS THAT WILL BITE YOU
  ===========================================================================
  1. responseBufferLimit="0" on the handler. Without it IIS buffers the
     response, and GET /v1/stream (Server-Sent Events) delivers NOTHING to the
     browser until the stream closes — which it never does. The dashboard's
     live view simply appears dead, with no error anywhere.

  2. The application pool must not recycle. The API runs a background outbox
     poller and holds open SSE connections; an app-pool recycle kills both.
     IIS idles pools out after 20 minutes and restarts them every 29 hours by
     DEFAULT. Turn both off (Install-ItDashboard.ps1 does this, or by hand):

       Import-Module WebAdministration
       Set-ItemProperty IIS:\AppPools\ItDashboardApi -Name processModel.idleTimeout -Value "00:00:00"
       Set-ItemProperty IIS:\AppPools\ItDashboardApi -Name recycling.periodicRestart.time -Value "00:00:00"
       Set-ItemProperty IIS:\AppPools\ItDashboardApi -Name startMode -Value "AlwaysRunning"
  ============================================================================
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Remove any inherited handler of the same name before adding ours. -->
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script"
           responseBufferLimit="0" />
    </handlers>

    <httpPlatform
        processPath="C:\inetpub\itdashboard-api\venv\Scripts\python.exe"
        arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --no-access-log --timeout-keep-alive 75"
        stdoutLogEnabled="true"
        stdoutLogFile="C:\inetpub\itdashboard-api\logs\uvicorn"
        startupTimeLimit="120"
        startupRetryCount="3"
        requestTimeout="23:00:00"
        forwardWindowsAuthToken="false"
        processesPerApplication="1">

      <!--
        processesPerApplication MUST stay 1.

        Each process runs its own copy of the outbox poller on startup. Two
        processes means two pollers; `FOR UPDATE SKIP LOCKED` keeps that safe,
        but each event is then published by whichever process claimed it, and
        an SSE client attached to the other process would miss it unless Redis
        pub/sub is genuinely shared. One process avoids the whole question.
        Scale by adding a second SITE behind a load balancer, not by raising
        this, and only once Redis is confirmed shared.
      -->

      <environmentVariables>
        <!-- EDIT: point at your PostgreSQL instance. -->
        <environmentVariable name="DATABASE_URL"
            value="postgresql://hosp:CHANGE_ME@127.0.0.1:5432/hosp_prod" />

        <!-- EDIT: Redis-compatible endpoint. On Windows this is usually
             Memurai (127.0.0.1:6379). See IIS_DEPLOY.md section 3. -->
        <environmentVariable name="REDIS_URL" value="redis://127.0.0.1:6379" />

        <environmentVariable name="ENVIRONMENT" value="production" />
        <environmentVariable name="API_PORT" value="4000" />

        <environmentVariable name="LOGGING_ENABLED" value="True" />
        <environmentVariable name="LOG_LEVEL" value="info" />
        <environmentVariable name="LOG_TO_FILE" value="True" />
        <environmentVariable name="LOG_DIR" value="C:\inetpub\itdashboard-api\logs" />
        <environmentVariable name="LOG_RETENTION_HOURS" value="24" />

        <!-- Keep False. True logs the full body of every request, which for
             /v1/edge/ingest is every device health payload from every edge box
             on every poll. -->
        <environmentVariable name="LOG_REQUEST_BODY" value="False" />

        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>

    <!-- SSE must not be compressed; compression buffers the response. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Ingest batches are up to 100 messages; 8 MB is generous headroom. -->
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <!-- Let FastAPI's own error responses through rather than IIS's HTML. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
