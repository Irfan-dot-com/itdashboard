<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  IIS site config for the IT Dashboard FRONTEND (the static Vite build).

  Put this at the root of the frontend site, e.g.
      C:\inetpub\itdashboard-web\web.config
  with the contents of `frontend\dist\` beside it.

  PREREQUISITE: the URL Rewrite module.
      https://www.iis.net/downloads/microsoft/url-rewrite

  This is the easy half of the deployment — it is just static files. IIS is
  genuinely good at this.

  ===========================================================================
  TWO WAYS TO LAY THIS OUT
  ===========================================================================
  A. SAME ORIGIN (recommended). One site, one certificate, one hostname. The
     API is mounted as an IIS APPLICATION under this site at the paths below,
     so the browser never makes a cross-origin request and CORS is irrelevant.
     Build the frontend with VITE_API_BASE_URL=https://dashboard.yourdomain.com

  B. TWO HOSTNAMES. dashboard.yourdomain.com for this site,
     api.yourdomain.com for the API site. Build with
     VITE_API_BASE_URL=https://api.yourdomain.com and tighten
     allow_origins in app/main.py — requests are now cross-origin and DO
     need CORS. Then DELETE the ApiPassthrough rule below.

  Note VITE_API_BASE_URL is baked in at BUILD time. Changing the hostname
  later means rebuilding the frontend, not editing a config file.
  ============================================================================
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          Layout A only: hand API paths to the API application and stop.
          Delete this rule if you use layout B (separate hostnames).

          This assumes the API is configured as an IIS application at /api-app
          or similar; if instead the API is a separate site on another port,
          replace the action with an ARR reverse-proxy Rewrite to
          http://127.0.0.1:4000/{R:0} — and read the SSE buffering warning in
          IIS_DEPLOY.md section 6 before you do.
        -->
        <rule name="ApiPassthrough" stopProcessing="true">
          <match url="^(v1/.*|livez|readyz|healthz|docs|docs/.*|openapi\.json)$" />
          <action type="None" />
        </rule>

        <!--
          SPA fallback: anything that is not a real file or directory is
          handled by index.html, so client-side routes survive a page reload.
          Without this, refreshing on /alerts/alr_abc123 returns a 404.
        -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Vite emits hashed asset filenames, so they can cache hard. -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

  </system.webServer>

  <location path="index.html">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <!-- index.html must NOT be cached, or a deploy leaves browsers
               loading the old bundle. -->
          <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
