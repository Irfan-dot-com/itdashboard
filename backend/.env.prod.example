# Copy this file to .env.prod and fill in the values before deploying.
# .env.prod is git-ignored — never commit real credentials.

# PostgreSQL
POSTGRES_DB=hosp_prod
POSTGRES_USER=hosp
POSTGRES_PASSWORD=change_me_strong_password

# These are set automatically by docker-compose.prod.yml using the values above.
# Only needed here if you run the API outside of Docker.
DATABASE_URL=postgresql://hosp:change_me_strong_password@postgres:5432/hosp_prod
REDIS_URL=redis://redis:6379

# API settings
API_PORT=4000
ENVIRONMENT=production

 # --- Logging ---
LOGGING_ENABLED=True          # True = full logs, False = minimal (method+path+status only)
LOG_LEVEL=debug               # debug | info | warning | error
LOG_TO_FILE=True              # True = write to LOG_DIR/app.log
LOG_DIR=logs                  # directory for rotating log files
LOG_RETENTION_HOURS=4         # how many hourly log files to keep (4 = last 4 hours)
LOG_REQUEST_BODY=True         # True = include request body in logs (set False to hide PII)