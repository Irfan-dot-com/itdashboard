# =============================================================================
# Caddy — PoC profile. API only, no dashboard UI.
#
# Pairs with docker-compose.poc.yml.
#
# ===========================================================================
# YOU DO NOT EDIT THIS FILE. Set SITE_ADDRESS in .env.prod instead:
# ===========================================================================
#
#   SITE_ADDRESS=:80
#       Plain HTTP on whatever address the box has. No domain name needed,
#       no certificate, nothing to configure. Reach it at
#       http://<your-elastic-ip>/livez
#       Use this to get the PoC working. Fine for test data; do NOT send real
#       customer data over it.
#
#   SITE_ADDRESS=dashboard.yourcompany.com
#       Automatic HTTPS. Caddy obtains and renews a Let's Encrypt certificate
#       by itself. Requires: you own that domain, an A record already points
#       it at this server, and port 80 is open (Let's Encrypt validates over
#       it). Also set ACME_EMAIL in .env.prod.
#
# The default is :80 — so if you set nothing, you get working HTTP rather
# than a failing certificate request.
# =============================================================================

{
	# Only used when SITE_ADDRESS is a hostname. Harmless otherwise.
	email {$ACME_EMAIL:admin@example.invalid}

	# Uncomment while testing HTTPS so a misconfiguration does not burn the
	# Let's Encrypt rate limit (5 failures per hostname per hour). Staging
	# certificates are NOT trusted by browsers or by the agents' preflight.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS::80} {

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Small access log — a free-tier box has a 30 GB disk.
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format json
	}

	# The live SSE stream. flush_interval -1 disables response buffering;
	# without it the stream never reaches the client, with no error anywhere.
	@sse path /v1/stream*

	# The only path the edge agents use.
	@ingest path /v1/edge/*

	# Everything else FastAPI serves, including the health probes.
	@api path /v1/* /livez /readyz /healthz /docs /docs/* /openapi.json

	# `route` preserves the order written here; without it Caddy applies its
	# own sorting and the overlapping /v1/* matchers may not run in this order.
	route {
		reverse_proxy @sse api:4000 {
			flush_interval -1
			transport http {
				read_timeout 24h
			}
		}

		reverse_proxy @ingest api:4000 {
			header_up X-Real-IP {remote_host}
		}

		reverse_proxy @api api:4000 {
			header_up X-Real-IP {remote_host}
		}

		# No dashboard UI in the PoC stack, so anything else gets a plain hint
		# rather than a confusing 502 from a missing upstream.
		respond "IT Dashboard API (PoC). The dashboard UI is not deployed on this instance. Health check: /livez" 200
	}
}
