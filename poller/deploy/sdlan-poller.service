[Unit]
Description=Corning SD-LAN Poller (IT Dashboard)
Documentation=file:/opt/sdlan-poller/app/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sdlan-poller
Group=sdlan-poller
WorkingDirectory=/opt/sdlan-poller/app
ExecStart=/opt/sdlan-poller/venv/bin/python -u /opt/sdlan-poller/app/main.py

Restart=always
RestartSec=10s
StartLimitIntervalSec=0

# Writable state
StateDirectory=sdlan-poller
LogsDirectory=sdlan-poller
ReadWritePaths=/var/lib/sdlan-poller /var/log/sdlan-poller

# Hardening. Unlike the syslog agent this process binds NO listening port -
# it only makes outbound HTTPS calls - so it needs no capabilities at all.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Resource ceilings
MemoryMax=512M
TasksMax=32

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sdlan-poller

[Install]
WantedBy=multi-user.target
