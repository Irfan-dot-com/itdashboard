{
  "_README": [
    "Copy to /etc/sdlan-poller/config.json and edit for THIS edge box.",
    "It overrides DEFAULT_CONFIG in config.py key by key, so the code is",
    "identical on every box - only this file changes per site.",
    "",
    "  sudo mkdir -p /etc/sdlan-poller",
    "  sudo cp config.example.json /etc/sdlan-poller/config.json",
    "  sudo nano /etc/sdlan-poller/config.json",
    "  sudo chown root:sdlan-poller /etc/sdlan-poller/config.json",
    "  sudo chmod 640 /etc/sdlan-poller/config.json",
    "",
    "THIS FILE CONTAINS THE SD-LAN PASSWORD. It must never be world-readable",
    "and must never be committed to git. preflight.py check 2 verifies the mode.",
    "",
    "Then, in order:",
    "  python3 probe.py       - see what the platform actually returns",
    "  python3 preflight.py   - ten readiness checks including a live test POST",
    "  sudo systemctl enable --now sdlan-poller",
    "",
    "Ask the customer for a READ-ONLY API account. The tech pub's examples use",
    "admin/admin; this poller only ever issues GET-equivalent queries and never",
    "writes, so it does not need administrative rights."
  ],

  "edge_id": "EDIT-ME-sdlan-sheraton-01",
  "service_provider": "bluip",
  "property_id": "EDIT-ME-234",
  "property_name": "EDIT-ME-Sheraton Downtown",
  "cloud_endpoint": "https://EDIT-ME-dashboard.example.com/v1/edge/ingest",

  "sdlan_base_url": "https://EDIT-ME-sdlan.customer.example.net",
  "sdlan_username": "EDIT-ME-readonly-api-user",
  "sdlan_password": "EDIT-ME",
  "sdlan_http_method": "POST",
  "sdlan_post_format": "form",
  "sdlan_verify_tls": true,
  "sdlan_ca_bundle": "",
  "sdlan_timeout_seconds": 30,

  "poll_interval_seconds": 300,
  "sdlan_setname": "",
  "sdlan_site": "",

  "device_id_source": "dev_id",
  "device_id_prefix": "EDIT-ME-sdlan-234",
  "default_device_class": "switch",
  "device_overrides": {},
  "report_platform_as_device": true,
  "platform_device_class": "orchestrator",

  "temp_warn_celsius": 55.0,
  "temp_crit_celsius": 70.0,
  "optical_rx_warn_dbm": -20.0,
  "link_flap_window_seconds": 900,
  "link_flap_min_changes": 3,
  "platform_freespace_warn_percent": 15.0,

  "queue_db_path": "/var/lib/sdlan-poller/queue.db",
  "state_db_path": "/var/lib/sdlan-poller/state.db",
  "upload_batch_size": 50,
  "upload_retry_seconds": 30,
  "cloud_upload_log_path": "/var/log/sdlan-poller/cloud_upload.log",
  "sdlan_raw_log_path": ""
}
