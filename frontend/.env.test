# Vitest loads this file when NODE_ENV=test (Vite mode "test").
# Values mirror development so `@/lib/env/env` parses during MSW/server imports.
VITE_APP_NAME="IT Dashboard (vitest)"
VITE_APP_ENV="development"
VITE_API_BASE_URL="http://localhost:8080"
VITE_ENABLE_MSW="false"
VITE_ENABLE_SIMULATION="false"
VITE_RELEASE_VERSION="test"
